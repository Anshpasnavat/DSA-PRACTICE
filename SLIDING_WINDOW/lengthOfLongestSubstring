class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_set<char>m;
        int left = 0;
        int length = 0;

        for(int right = 0;right<s.length();right++ ){
            while(m.find(s[right])!=m.end()){
                m.erase(s[left]);
                left++;
            }
            m.insert(s[right]);
            length = max(length, right - left + 1); 

        }  return length;  
    }
};