class Solution {
  public:
    vector<int> findWays(vector<vector<int>>& grid) {
        int n = grid.size(), mod = 1e9 + 7;
        vector<vector<int>> dp(n, vector<int>(n, 0));
        vector<vector<int>> best(n, vector<int>(n, 0));
        
        dp[0][0] = 1;
        best[0][0] = grid[0][0];
        
        for(int i = 0; i < n; i++){
            for(int j = 0; j < n; j++){
                if (dp[i][j] == 0)
                    continue;
                if(j + 1 < n && (grid[i][j] == 1 || grid[i][j] == 3)){
                    dp[i][j + 1] = (dp[i][j + 1] + dp[i][j]) % mod;
                    best[i][j + 1] = max(best[i][j + 1], best[i][j] + grid[i][j + 1]);
                }
                if(i + 1 < n && (grid[i][j] == 2 || grid[i][j] == 3)){
                    dp[i + 1][j] = (dp[i + 1][j] + dp[i][j]) % mod;
                    best[i + 1][j] = max(best[i + 1][j], best[i][j] + grid[i + 1][j]);
                }
            }
        }
        return {dp[n - 1][n - 1], best[n - 1][n - 1]};
    }
};