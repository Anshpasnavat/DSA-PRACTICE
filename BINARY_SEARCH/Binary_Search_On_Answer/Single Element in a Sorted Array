#include<iostream>
#include<climits>
using namespace std;

int singleNonDuplicate(int arr[], int n){
    int left = 0;
    int right = n-1;
    while(left < right){
        int mid = left+(right-left)/2;
        if(mid%2==0){
            if(arr[mid] == arr[mid+1]){
                left = mid + 2;
            }else{
                right = mid;
            }
        }else{
            if(arr[mid] == arr[mid-1]){
                left = mid +1;
            }else{
                right = mid ;
            }
        }
    }  return arr[right];      
}

int main(){
    int arr[] = {1,1,2,3,3,4,4,5,5};
    int n  = sizeof(arr)/sizeof(int);
    cout << singleNonDuplicate(arr , n );
}