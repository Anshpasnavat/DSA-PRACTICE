#include<iostream>
using  namespace std;

int lowerBound(int arr[], int n, int target){
    int ans = n;
    int left = 0;
    int right = n-1;
    while(left<=right){
        int mid = left+(right-left)/2;
        if(arr[mid]>=target){
            ans = mid;
            right = mid-1;
        }else{
            left = mid + 1;
        }

    }
    return ans;
}

int main (){
    int arr[] = {1,2,3,4,5};
    int n = sizeof(arr)/sizeof(int);
    int target = 3;
    cout << lowerBound(arr, n, target);
}