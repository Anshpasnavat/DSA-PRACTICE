class Solution {
public:
    bool isValid(string s) {

        stack<char> st;

        for(char ch : s) {

            if(ch == '(' || ch == '{' || ch == '[') {

                st.push(ch);

            }
            else {

                if(st.empty()){
                    return false;
                }
                // Match the closing bracket here
                if(ch == ')' && st.top() != '('){
                    return false;
                }if(ch == '}' && st.top() !='{'){
                    return false;
                }if(ch == ']' && st.top() != '['){
                    return false;
                }
                st.pop();

            }
        }

        return st.empty();
    }
};